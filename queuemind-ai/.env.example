# ==========================================
# QueueMind AI - Environment Configuration
# ==========================================

# Core Application
PROJECT_NAME="QueueMind AI"
DEMO_MODE=true
SECRET_KEY="queuemind-super-secret-jwt-key-hackathon-2026-prod"
DATABASE_URL="sqlite:///./queuemind.db"
# For AWS RDS PostgreSQL:
# DATABASE_URL="postgresql://postgres:YourSecurePassword@queuemind-db.cluster-xxx.us-east-1.rds.amazonaws.com:5432/queuemind"

# AWS Cloud Integration (Gracefully falls back to local simulation when keys are empty)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="queuemind-ai-media-storage"
AWS_SNS_TOPIC_ARN="arn:aws:sns:us-east-1:123456789012:queuemind-alerts"
AWS_CLOUDWATCH_LOG_GROUP="/aws/apprunner/queuemind-ai"

# Frontend URLs
NEXT_PUBLIC_API_URL="http://127.0.0.1:8000/api"
NEXT_PUBLIC_WS_URL="ws://127.0.0.1:8000"
